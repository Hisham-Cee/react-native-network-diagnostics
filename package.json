{
  "name": "react-native-network-diagnostics",
  "version": "0.1.0",
  "description": "Network health diagnostics for React Native: OS internet validation, captive portal, metered and constrained state, and HTTPS latency to your own endpoint. New Architecture TurboModule.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-network-diagnostics-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "!android/src/test",
    "!ios/Tests",
    "!ios/Package.swift",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "scripts": {
    "example": "yarn workspace react-native-network-diagnostics-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "format": "prettier --check \"src/**/*.{ts,tsx}\" \"example/src/**/*.{ts,tsx}\" \"*.{js,mjs,json,md}\" \"docs/**/*.md\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx}\" \"example/src/**/*.{ts,tsx}\" \"*.{js,mjs,json,md}\" \"docs/**/*.md\"",
    "codegen:check": "node scripts/check-codegen.js"
  },
  "keywords": [
    "react-native",
    "network",
    "network-diagnostics",
    "connectivity",
    "internet",
    "latency",
    "captive-portal",
    "turbomodule",
    "new-architecture",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hisham-Cee/react-native-network-diagnostics.git"
  },
  "author": "Hisham Mohammed <hishamcee@gmail.com> (https://github.com/Hisham-Cee)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Hisham-Cee/react-native-network-diagnostics/issues"
  },
  "homepage": "https://github.com/Hisham-Cee/react-native-network-diagnostics#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.2",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.1",
    "test-renderer": "^1.0.0",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.80.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "NetworkDiagnosticsSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.networkdiagnostics"
    },
    "ios": {
      "modulesProvider": {
        "NetworkDiagnostics": "NetworkDiagnostics"
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint"
    ],
    "version": "0.63.1"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts?(x)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/NativeNetworkDiagnostics.ts"
    ]
  }
}
